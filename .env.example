# ============================================================================
# 小智AI桌宠 · 环境变量模板
#
# 用法：复制成仓库根目录的 .env，填自己的值，然后按 README 第 3 节启动。
#   Copy-Item .env.example .env
#
# .env 已在 .gitignore 里，不会被提交；仓库里不含任何真实 Key。
# 配置读取顺序：main/xiaozhi-server/config/env_expand.py 从 xiaozhi-server 目录
# 逐级向上找 .env，找到即加载，再把 data/.config.yaml 里的 ${变量名} 展开。
#
# 引用位置：main/xiaozhi-server/data/.config.yaml
#   → LLM.DeepSeekLLM.api_key / VLLM.DeepSeekVLLM.api_key   ${DEEPSEEK_API_KEY}
#   → TTS.HuoshanDoubleStreamTTSV2.appid / access_token     ${VOLC_APPID} / ${VOLC_ACCESS_TOKEN}
#   → plugins.web_search.tavily.api_key                     ${TAVILY_API_KEY}
# ============================================================================

# DeepSeek：对话与截图理解共用一个 Key，必填
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 火山引擎豆包语音合成 2.0：默认 TTS 就是它，必填
# 开通：https://console.volcengine.com/speech/app
# 不想用云 TTS：留空，并把 data/.config.yaml 的 selected_module.TTS 改回 SapiLocal
VOLC_APPID=
VOLC_ACCESS_TOKEN=

# 可选：Tavily 联网搜索 Key（不填则走免 Key 的多引擎搜索，速度慢一点）
TAVILY_API_KEY=
